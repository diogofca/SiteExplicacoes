---
import { site } from '../data/site';
---

<section id="top" class="relative overflow-hidden bg-grid">
  <!-- manchas de cor de fundo -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-32 -left-24 size-[28rem] rounded-full bg-brand/25 blur-3xl"></div>
    <div class="absolute top-20 -right-32 size-[26rem] rounded-full bg-aqua/25 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 size-72 rounded-full bg-accent/20 blur-3xl"></div>
  </div>

  <!-- fórmulas decorativas -->
  <div
    class="pointer-events-none absolute inset-0 hidden font-display text-brand/15 select-none lg:block"
    aria-hidden="true"
  >
    <span class="absolute top-24 left-[6%] text-5xl">∫₀¹ x² dx</span>
    <span class="absolute bottom-20 left-[5%] text-4xl">Δ = b² − 4ac</span>
    <span class="absolute top-24 right-[8%] text-4xl">lim<sub>x→∞</sub> f(x)</span>
    <span class="absolute top-[62%] right-[4%] text-4xl">sin²θ + cos²θ = 1</span>
  </div>

  <div class="container-site relative flex flex-col items-center py-24 text-center sm:py-32">
    <span
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand/20 bg-white/70 px-4 py-1.5 text-sm font-medium text-brand-deep shadow-sm"
    >
      <span class="size-2 rounded-full bg-aqua" aria-hidden="true"></span>
      {site.cidade} · Online
    </span>

    <h1 class="font-display max-w-4xl text-4xl leading-[1.1] font-bold tracking-tight sm:text-6xl">
      Explicações de <span class="gradient-text">Matemática</span>, do 7º ao 12º ano
    </h1>

    <p class="mt-6 max-w-xl text-lg text-ink-soft sm:text-xl">
      Sou o {site.nome}, aluno de Matemática na {site.faculdade}.
    </p>
    <p class="mt-2 text-sm text-ink-soft/70">
      Média de {site.mediaSecundario} no secundário · {site.mediaFaculdade} na licenciatura
    </p>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href="#contacto" class="btn-primary">Marcar aula</a>
      <a href="#precos" class="btn-secondary">Ver preços</a>
    </div>
  </div>
</section>
