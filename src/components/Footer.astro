---
import { site, navLinks, mailtoHref } from '../data/site';
const ano = new Date().getFullYear();
---

<footer class="border-t border-ink/5 bg-white">
  <div class="container-site flex flex-col items-start justify-between gap-6 py-10 sm:flex-row sm:items-center">
    <div>
      <p class="font-display text-lg font-bold">{site.nome}</p>
      <p class="text-sm text-ink-soft">Explicações de Matemática · {site.cidade} · Online</p>
      <a href={mailtoHref} class="mt-1 inline-block text-sm font-medium text-brand hover:underline">{site.email}</a>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft" aria-label="Rodapé">
      {navLinks.map((l) => (
        <a href={l.href} class="hover:text-brand">{l.label}</a>
      ))}
      <a href="#contacto" class="hover:text-brand">Contacto</a>
    </nav>
  </div>
  <div class="container-site border-t border-ink/5 py-4 text-xs text-ink-soft">
    © {ano} {site.nome}. Todos os direitos reservados.
  </div>
</footer>
