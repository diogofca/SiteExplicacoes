---
import { niveis, site } from '../data/site';
---

<section id="servicos" class="scroll-mt-20 bg-tint py-20 sm:py-28">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <span class="section-kicker">Serviços</span>
      <h2 class="section-title">Aulas presenciais na {site.cidade}</h2>
    </div>

    <div class="mx-auto mt-12 grid max-w-3xl gap-6 md:grid-cols-2">
      {niveis.map((n) => (
        <article class="rounded-3xl border border-ink/5 bg-white p-8 text-center shadow-sm">
          <p class="text-sm font-semibold text-brand">{n.anos}</p>
          <h3 class="font-display mt-1 text-2xl font-bold">{n.nome}</h3>
        </article>
      ))}
    </div>
  </div>
</section>
