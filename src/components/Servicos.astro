---
import { niveis, modalidades } from '../data/site';
---

<section id="servicos" class="scroll-mt-20 bg-tint py-20 sm:py-28">
  <div class="container-site">
    <div class="max-w-2xl">
      <span class="section-kicker">Serviços</span>
      <h2 class="section-title">Explicações adaptadas ao teu ano e aos teus objetivos</h2>
      <p class="mt-4 text-lg text-ink-soft">
        Do acompanhamento semanal à preparação intensiva para exames, ajusto o plano ao que precisas.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {niveis.map((n) => (
        <article class="flex flex-col rounded-3xl border border-ink/5 bg-white p-8 shadow-sm">
          <p class="text-sm font-semibold text-brand">{n.anos}</p>
          <h3 class="font-display mt-1 text-2xl font-bold">{n.nome}</h3>
          <p class="mt-3 text-ink-soft">{n.resumo}</p>
          <ul class="mt-6 space-y-3">
            {n.topicos.map((t) => (
              <li class="flex items-start gap-3 text-ink">
                <span
                  class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-aqua-soft text-xs font-bold text-aqua"
                  aria-hidden="true">✓</span
                >
                {t}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
      {modalidades.map((m) => (
        <div class="flex flex-1 items-center gap-4 rounded-2xl border border-ink/5 bg-white px-5 py-4 shadow-sm">
          <span
            class="grid size-11 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-brand to-aqua text-white"
            aria-hidden="true"
          >
            {m.icone === 'pin' ? (
              <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-6.2-7-11a7 7 0 1114 0c0 4.8-7 11-7 11z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            ) : (
              <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="12" rx="2" />
                <path stroke-linecap="round" d="M8 21h8M12 17v4" />
              </svg>
            )}
          </span>
          <div>
            <p class="font-semibold">{m.nome}</p>
            <p class="text-sm text-ink-soft">{m.detalhe}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
