---
import { niveis } from '../data/site';
---

<section id="precos" class="scroll-mt-20 bg-tint py-20 sm:py-28">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <span class="section-kicker">Preços</span>
      <h2 class="section-title">Por hora</h2>
    </div>

    <div class="mx-auto mt-12 grid max-w-3xl gap-6 md:grid-cols-2">
      {niveis.map((n, i) => (
        <div
          class:list={[
            'flex flex-col rounded-3xl p-8 shadow-sm',
            i === 1 ? 'bg-ink text-white' : 'border border-ink/5 bg-white',
          ]}
        >
          <p class:list={['text-sm font-semibold', i === 1 ? 'text-aqua' : 'text-brand']}>{n.anos}</p>
          <h3 class="font-display mt-1 text-2xl font-bold">{n.nome}</h3>
          <p class="mt-6 flex items-baseline gap-1">
            <span class="font-display text-5xl font-bold tracking-tight">{n.preco} €</span>
            <span class:list={['text-sm', i === 1 ? 'text-white/70' : 'text-ink-soft']}>/ hora</span>
          </p>
          <a
            href="#contacto"
            class:list={[
              'mt-8 inline-flex justify-center rounded-full px-6 py-3 font-semibold transition',
              i === 1 ? 'bg-white text-ink hover:bg-aqua-soft' : 'bg-brand text-white hover:bg-brand-deep',
            ]}
          >
            Marcar aula
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
